# ======================================================================
# 青衫诊所 · 环境变量模板
# 用法：cp .env.example .env.local（本地） / cp .env.example .env（服务器）
#       服务器上把带「生产必改」标记的项全部改掉。.env* 已 gitignore，不入库。
# ======================================================================

# ---- 应用栈（本地+生产通用）----
# 生产必改：openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=clinic_pw
REDIS_PASSWORD=clinic_redis
# 监控面 mysqld-exporter 专用账号（与 infra/mysql-init/01-exporter.sql 一致）
MYSQL_EXPORTER_PASSWORD=exporter_pw

# ---- 监控栈 ----
# 生产必改：Grafana admin 密码
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# 2g 服务器建议 7d，4g 可 15d
PROM_RETENTION=15d

# ---- 黑盒探测目标（生产改成 https://你的域名/）----
PROBE_TARGET=http://frontend/

# ---- ai-bot（P3 启用；OpenAI 兼容接口，可接任意供应商）----
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Telegram 推送（找 @BotFather 建 bot；@userinfobot 查 chat_id）
TG_BOT_TOKEN=
TG_CHAT_ID=
